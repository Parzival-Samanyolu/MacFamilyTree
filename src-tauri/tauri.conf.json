{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KinTree",
  "version": "0.1.0",
  "identifier": "org.kintree.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui ci && npm --prefix ../ui run build"
  },
  "app": {
    "windows": [{ "title": "KinTree", "width": 1320, "height": 840, "minWidth": 960, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Private, offline family-tree software",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
